// 正方体六面体网格生成脚本（最终修正版）
// 空间范围：x∈[-1,1], y∈[-1,1], z∈[-1,1]

// --------------------------
// 1. 定义8个顶点（坐标严格对应正方体角点）
// --------------------------
Point(1) = { 1,  1,  1, 1.0};  // (x+, y+, z+)
Point(2) = { 1,  1, -1, 1.0};  // (x+, y+, z-)
Point(3) = { 1, -1, -1, 1.0};  // (x+, y-, z-)
Point(4) = { 1, -1,  1, 1.0};  // (x+, y-, z+)
Point(5) = {-1,  1,  1, 1.0};  // (x-, y+, z+)
Point(6) = {-1,  1, -1, 1.0};  // (x-, y+, z-)
Point(7) = {-1, -1, -1, 1.0};  // (x-, y-, z-)
Point(8) = {-1, -1,  1, 1.0};  // (x-, y-, z+)

// --------------------------
// 2. 定义12条棱边（线的方向严格按“点→点”连续）
// --------------------------
// 前面（x=1）：1→2→3→4→1（闭合）
Line(1)  = {1, 2};   // 1→2
Line(2)  = {2, 3};   // 2→3
Line(3)  = {3, 4};   // 3→4
Line(4)  = {4, 1};   // 4→1

// 后面（x=-1）：5→6→7→8→5（闭合）
Line(5)  = {5, 6};   // 5→6
Line(6)  = {6, 7};   // 6→7
Line(7)  = {7, 8};   // 7→8
Line(8)  = {8, 5};   // 8→5

// 连接前后的竖边（x方向）：1→5, 2→6, 3→7, 4→8
Line(9)  = {1, 5};   // 1→5
Line(10) = {2, 6};   // 2→6
Line(11) = {3, 7};   // 3→7
Line(12) = {4, 8};   // 4→8

// --------------------------
// 3. 定义6个面（线环严格闭合，每条线终点=下条线起点）
// --------------------------
// 前面（x=1）：1→2→3→4→1
Line Loop(13) = {1, 2, 3, 4};
Plane Surface(14) = {13};

// 后面（x=-1）：5→6→7→8→5
Line Loop(15) = {5, 6, 7, 8};
Plane Surface(16) = {15};

// 上面（y=1）：1→2→6→5→1
Line Loop(17) = {1, 10, -5, -9};  // 1→2（1）→6（10）→5（-5：反向Line5）→1（-9：反向Line9）
Plane Surface(18) = {17};

// 下面（y=-1）：3→4→8→7→3
Line Loop(19) = {3, 12, 7, -11};  // 3→4（3）→8（12）→7（7）→3（-11：反向Line11）
Plane Surface(20) = {19};

// 右面（z=1）：1→4→8→5→1
Line Loop(21) = {4, 12, 8, -9};   // 1→4（4）→8（12）→5（8）→1（-9：反向Line9）
Plane Surface(22) = {21};

// 左面（z=-1）：2→3→7→6→2
Line Loop(23) = {2, 11, 6, -10};  // 2→3（2）→7（11）→6（6）→2（-10：反向Line10）
Plane Surface(24) = {23};

// --------------------------
// 4. 定义正方体实体（6个面闭合）
// --------------------------
Surface Loop(25) = {14, 16, 18, 20, 22, 24};
Volume(26) = {25};

// --------------------------
// 5. 结构化六面体网格参数
// --------------------------
nx = 2;  // x方向网格数
ny = 2;  // y方向网格数
nz = 2;  // z方向网格数

// 按方向分配线的分割数（确保网格对齐）
Transfinite Line{1,5}   = nz;  // z方向线（上/后面竖边）
Transfinite Line{2,6}   = nx;  // x方向线（左/后面横边）
Transfinite Line{3,7}   = nz;  // z方向线（下/后面竖边）
Transfinite Line{4,8}   = nx;  // x方向线（右/后面横边）
Transfinite Line{9,10}  = ny;  // y方向线（上沿连接边）
Transfinite Line{11,12} = ny;  // y方向线（下沿连接边）

// 面网格结构化
Transfinite Surface{14,16,18,20,22,24};

// 体网格结构化（六面体）
Transfinite Volume{26};

// --------------------------
// 6. 物理组定义
// --------------------------
Physical Volume("Cube_Hex") = {26};
