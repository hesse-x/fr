// 2D正方形四边形网格生成脚本
// 范围：x∈[-1,1]，y∈[-1,1]

// 1. 定义正方形的4个顶点
Point(1) = {-1, -1, 0, 1.0};  // 左下 (-1,-1)
Point(2) = { 1, -1, 0, 1.0};  // 右下 (1,-1)
Point(3) = { 1,  1, 0, 1.0};  // 右上 (1,1)
Point(4) = {-1,  1, 0, 1.0};  // 左上 (-1,1)

// 2. 定义4条边（线），按顺时针方向连接
Line(1) = {1, 2};  // 下边：左下→右下
Line(2) = {2, 3};  // 右边：右下→右上
Line(3) = {3, 4};  // 上边：右上→左上
Line(4) = {4, 1};  // 左边：左上→左下（闭合正方形）

// 3. 定义闭合线环（构成正方形面）
Line Loop(5) = {1, 2, 3, 4};  // 按边的顺序组成环，确保闭合
Plane Surface(6) = {5};       // 由线环生成平面

// 4. 设置结构化四边形网格
nx = 2;  // x方向网格数量（可修改，如3、4等）
ny = 2;  // y方向网格数量（同上）

// 对每条边设置网格分割数（确保四边形网格对齐）
Transfinite Line{1,3} = nx Using Progression 1;  // 水平边（x方向）
Transfinite Line{2,4} = ny Using Progression 1;  // 垂直边（y方向）

// 生成面的结构化网格（四边形）
Transfinite Surface{6};

// 5. 定义物理组（方便后续解析）
Physical Surface("Square_Quad_Mesh") = {6};
Physical Line("Boundary") = {1,2,3,4};  // 边界线（可选）
